# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment / secrets
.env
.env.*
!.env.example
*.local

# Data (never version raw, processed, or external historical datasets)
data/raw/
data/processed/
data/external/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
*.csv
*.parquet
*.feather

# Models (ignore old models, checkpoints, experiments; allow production model)
models/*
!models/.gitkeep
!models/best_model.joblib
!models/best_model_metadata.json
models/old/
models/checkpoints/
models/experiments/

# Logs
logs/
*.log

# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Jupyter notebooks
.ipynb_checkpoints/
*.ipynb

# Coverage reports
.coverage
htmlcov/
coverage.xml
