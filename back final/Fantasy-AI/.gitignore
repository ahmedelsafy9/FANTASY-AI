# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment / secrets
.env
.env.*
*.local

# Data (never version raw or processed datasets)
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Models (large binary artifacts)
models/*
!models/.gitkeep

# Logs
logs/
*.log

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Jupyter (explicitly excluded from this project, but ignore stray files)
.ipynb_checkpoints/
*.ipynb

# Coverage reports
.coverage
htmlcov/
coverage.xml
