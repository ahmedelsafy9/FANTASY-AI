# =================================================================
# Fantasy-AI Backend Environment Configuration Template
# =================================================================
# Copy this file to .env and adjust values for your environment.
# Do NOT commit real secrets to source control.

# Application Environment: 'development' | 'production' | 'test'
FANTASY_AI_ENV=development

# CORS Configuration: Comma-separated list of allowed frontend origins
# In production, set this to your deployed frontend domain(s).
# In development, http://localhost:3000, http://localhost:5173, http://127.0.0.1:3000, http://127.0.0.1:5173 are enabled by default.
FANTASY_AI_CORS_ORIGINS=https://fantasy-ai-roosters.vercel.app,http://localhost:3000,http://localhost:5173

# CORS Credentials flag (set to true when using cookie-based authentication)
FANTASY_AI_CORS_ALLOW_CREDENTIALS=true

# API Documentation URL (e.g. /swagger or empty to disable)
FANTASY_AI_API_DOCS_URL=/swagger

# Rate Limiting Storage URI (e.g. memory:// for single process, redis://localhost:6379 for multi-instance)
FANTASY_AI_RATE_LIMIT_STORAGE_URI=memory://
FANTASY_AI_RATE_LIMIT_DEFAULT=60/minute

# External Data Sources
FANTASY_AI_FPL_API_BASE_URL=https://fantasy.premierleague.com/api

# Authentication
# REQUIRED in production — set via `fly secrets set FANTASY_AI_JWT_SECRET=<random-64-char-string>`
FANTASY_AI_JWT_SECRET=dev-only-change-me-in-production
# JWT token lifetime in seconds (default: 7 days)
FANTASY_AI_JWT_EXPIRY_SECONDS=604800
# HTTP-only cookie name for the auth token
FANTASY_AI_AUTH_COOKIE_NAME=fantasy_ai_token
# Path to SQLite auth database file
FANTASY_AI_AUTH_DB_PATH=data/auth.db

# ---------------------------------------------------------------
# AI Chatbot Configuration
# ---------------------------------------------------------------
# Set FANTASY_AI_CHATBOT_ENABLED=true to enable the chatbot feature.
# To use AI mode (Gemini LLM with tool calling), you MUST provide
# a valid API key below. Without a key the chatbot falls back to
# a data-only mode with limited natural-language ability.
#
# Get your free Gemini API key from Google AI Studio:
#   https://aistudio.google.com/apikey
#
FANTASY_AI_CHATBOT_ENABLED=true
FANTASY_AI_LLM_PROVIDER=gemini
FANTASY_AI_LLM_API_KEY=
FANTASY_AI_LLM_MODEL=gemini-3.8-flash
FANTASY_AI_CHATBOT_MAX_TURNS=20
FANTASY_AI_CHATBOT_MAX_TOOL_CALLS=5
